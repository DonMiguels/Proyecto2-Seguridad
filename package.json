{
  "name": "red-deliveries-backend",
  "version": "1.0.0",
  "description": "Backend para la Red de Deliveries",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "docker-compose --profile prod up --build",
    "build": "docker compose --profile prod build backend",
    "dev": "docker-compose --profile dev up --build",
    "clean": "docker-compose down -v --remove-orphans",
    "debugging": "nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": [
    "deliveries",
    "backend",
    "nodejs",
    "express",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^8.1.7",
    "pg": "^8.11.3",
    "redis": "^5.11.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "nodemon": "^3.0.2",
    "pg-mem": "^3.0.5",
    "prettier": "^3.5.3",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
