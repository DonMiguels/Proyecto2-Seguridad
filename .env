PORT=3000
NODE_ENV=production

DB_HOST=db
DB_PORT=5432
DB_NAME=deliveries
DB_USER=postgres
DB_PASSWORD_FILE=/run/secrets/db_password

REDIS_URL=redis://redis:6379

JWT_ALGORITHM=HS256
JWT_SECRET_FILE=/run/secrets/jwt_secret
JWT_ISSUER=deliveries-api
JWT_AUDIENCE=deliveries-clients
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

LDAP_URL=ldaps://ldap:636
LDAP_BASE_DN=dc=empresa,dc=local
LDAP_USER_ATTRIBUTE=uid
LDAP_BIND_DN=cn=admin,dc=empresa,dc=local
LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind_password
LDAP_TLS_REJECT_UNAUTHORIZED=true
LDAP_ROLE_MAPPING={"cn=admins,ou=Groups,dc=empresa,dc=local":"ADMIN","cn=despacho,ou=Groups,dc=empresa,dc=local":"DESPACHO","cn=mostrador,ou=Groups,dc=empresa,dc=local":"MOSTRADOR","cn=atencion,ou=Groups,dc=empresa,dc=local":"ATENCION","cn=consulta,ou=Groups,dc=empresa,dc=local":"CONSULTA"}

LOG_GMT_OFFSET=-4
